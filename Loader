local universeId = game.GameId
local scriptUrl = Scripts[universeId]

if not scriptUrl then
    warn(("No loader configured for universe %d"):format(universeId))
    return
end

local ok, source = pcall(game.HttpGet, game, scriptUrl)

if not ok then
    warn("Couldn't fetch script.")
    return
end

local chunk, err = loadstring(source)

if not chunk then
    warn(err)
    return
end

chunk()
